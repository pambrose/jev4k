# Copy to .env (gitignored) and fill in. The com.pambrose.envvar plugin loads these into the
# environment of every Test and JavaExec task, so `make example` and `make live-tests` pick them up.
TYPESAFE_API_KEY=ts-...
# Optional overrides; the defaults are https://api.typesafe.ai and jev-latest.
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Don't put JEV4K_LIVE here. It is what enables LiveSmokeTest, and because this file reaches every test
# task, setting it would turn each `make tests` into a run that spends tokens. `make live-tests` sets it
# for that one invocation, which is the only place it belongs.
